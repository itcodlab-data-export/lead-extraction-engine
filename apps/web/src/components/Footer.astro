---
import { withBase } from "../lib/withBase";
import { BRAND, TAGLINE, BUILT_AT } from "../lib/site";
const cols = [
  { h: "Company", l: [["About", "/about/"], ["Contact", "/contact/"], ["Lab", "/lab/"]] },
  { h: "Products", l: [["Lead Extraction Engine", "/products/lead-extraction-engine/"], ["Lead Sending Engine", "/products/lead-sending-engine/"], ["Early Access", "/early-access/"]] },
  { h: "Services", l: [["Meta Ads + CAPI", "/services/meta-ads-capi/"], ["Social Media Growth", "/services/social-media-growth/"], ["IT & Automation", "/services/it-automation/"]] },
  { h: "Legal", l: [["Privacy Policy", "/privacy-policy/"], ["Terms", "/terms/"]] },
];
---
<footer class="border-t border-hairline bg-surface">
  <div class="wrap grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-5">
    <div class="lg:col-span-1">
      <p class="font-display text-lg font-bold">{BRAND}</p>
      <p class="mt-3 text-sm text-ink-2">{TAGLINE}</p>
    </div>
    {cols.map((c) => (
      <nav aria-label={c.h}>
        <h3 class="eyebrow mb-4" style="font-family:var(--font-mono);font-size:.75rem;letter-spacing:.1em">{c.h}</h3>
        <ul class="space-y-3 text-sm">
          {c.l.map(([t, h]) => <li><a href={withBase(h)} class="text-ink-2 hover:text-ink">{t}</a></li>)}
        </ul>
      </nav>
    ))}
  </div>
  <div class="wrap flex flex-wrap justify-between gap-2 border-t border-hairline py-6 font-mono text-xs text-ink-2">
    <span>© {new Date(BUILT_AT).getUTCFullYear()} {BRAND}</span>
    <span>Last updated: <time datetime={BUILT_AT}>{BUILT_AT.slice(0, 10)}</time></span>
  </div>
</footer>
