---
import { FORM_ENDPOINT, TURNSTILE_KEY } from "../lib/site";
interface Props { source: string; selectLabel: string; options: string[]; cta: string }
const { source, selectLabel, options, cta } = Astro.props;
const ready = Boolean(FORM_ENDPOINT && TURNSTILE_KEY);
---
{ready ? (
  <form id="inquiry-form" data-endpoint={FORM_ENDPOINT} data-source={source} class="grid gap-4" novalidate>
    <label class="grid gap-1 text-sm font-semibold">Name
      <input class="field" name="name" autocomplete="name" required maxlength="120" /></label>
    <label class="grid gap-1 text-sm font-semibold">Work email
      <input class="field" type="email" name="email" autocomplete="email" required maxlength="200" /></label>
    <label class="grid gap-1 text-sm font-semibold">Company <span class="font-normal text-ink-2">(optional)</span>
      <input class="field" name="company" autocomplete="organization" maxlength="160" /></label>
    <label class="grid gap-1 text-sm font-semibold">{selectLabel}
      <select class="field" name="interest">{options.map((o) => <option>{o}</option>)}</select></label>
    <label class="grid gap-1 text-sm font-semibold">Message
      <textarea class="field" name="message" rows="4" maxlength="2000"></textarea></label>
    <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
    <div class="cf-turnstile" data-sitekey={TURNSTILE_KEY}></div>
    <button class="btn-primary" type="submit">{cta}</button>
    <p id="form-status" role="status" aria-live="polite" class="text-sm text-ink-2"></p>
    <p class="text-xs text-ink-2">We use your details only to reply. See the privacy policy.</p>
  </form>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script>
    const f = document.getElementById("inquiry-form") as HTMLFormElement | null;
    const out = document.getElementById("form-status")!;
    f?.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!f.reportValidity()) return;
      out.textContent = "Sending…";
      const body = Object.fromEntries(new FormData(f).entries());
      try {
        const r = await fetch(f.dataset.endpoint!, {
          method: "POST", headers: { "content-type": "application/json" },
          body: JSON.stringify({ ...body, source: f.dataset.source }),
        });
        out.textContent = r.ok ? "Thanks — we will reply by email." : "Could not send. Please retry in a moment.";
        if (r.ok) f.reset();
      } catch { out.textContent = "Network error. Please retry."; }
      (window as any).turnstile?.reset();
    });
  </script>
) : (
  <p class="tile text-sm text-ink-2">The inquiry form activates once the form endpoint and Turnstile key are configured for this build.</p>
)}
