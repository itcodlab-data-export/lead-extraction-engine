---
import { withBase } from "../lib/withBase";
---
<section class="wrap section text-center">
  <h2 class="mx-auto max-w-3xl">See where your ad tracking is leaking signal.</h2>
  <p class="lede mx-auto mt-4 max-w-xl">Book a free audit, or join the early-access list for the client portal.</p>
  <div class="mt-8 flex flex-wrap justify-center gap-3">
    <a href={withBase("/contact/#book")} class="btn-primary">Book Free Audit</a>
    <a href={withBase("/early-access/")} class="btn-ghost">Join Early Access</a>
  </div>
</section>
