---
const items = [
  ["9-Layer Deliverability Safety", "Verification, suppression and fixed sending ceilings that fail closed."],
  ["DPDP, CAN-SPAM & PECR", "Designed around opt-outs, suppression lists and clear sender identity."],
  ["100% Self-Owned Data", "Output lands in a workspace you control. No exported CSV copies."],
];
const a = { fill: "none", stroke: "currentColor", "stroke-width": "1.25", "stroke-linejoin": "round", "stroke-linecap": "round" } as const;
---
<section class="wrap section" aria-labelledby="safety-h">
  <p class="eyebrow">Compliance</p>
  <h2 id="safety-h" class="mt-3 max-w-3xl">Safety &amp; Compliance, Built In</h2>
  <ul class="mt-12 grid gap-10 md:grid-cols-3">
    <li>
      <svg viewBox="0 0 64 64" width="64" height="64" class="text-brand" aria-hidden="true" {...a}>
        <path d="M32 6l22 8v16c0 14-9 24-22 28C19 54 10 44 10 30V14z" /><path d="M32 16l14 5v10c0 9-6 16-14 19-8-3-14-10-14-19V21z" /><path d="M32 26l6 2v5c0 4-3 7-6 9-3-2-6-5-6-9v-5z" />
      </svg>
      <h3 class="mt-5">{items[0][0]}</h3><p class="mt-2 text-sm text-ink-2">{items[0][1]}</p>
    </li>
    <li>
      <svg viewBox="0 0 64 64" width="64" height="64" class="text-brand" aria-hidden="true" {...a}>
        <path d="M32 8v48M14 56h36M32 14H12M32 14h20" /><path d="M12 14L4 34h16zM52 14l-8 20h16z" /><circle cx="32" cy="10" r="2" />
      </svg>
      <h3 class="mt-5">{items[1][0]}</h3><p class="mt-2 text-sm text-ink-2">{items[1][1]}</p>
    </li>
    <li>
      <svg viewBox="0 0 64 64" width="64" height="64" class="text-brand" aria-hidden="true" {...a}>
        <rect x="8" y="14" width="48" height="38" rx="3" /><path d="M8 26h48" /><circle cx="32" cy="39" r="7" /><path d="M32 32v14M25 39h14" />
        <circle cx="50" cy="20" r="1.6" style="fill:var(--accent-red);stroke:none" />
      </svg>
      <h3 class="mt-5">{items[2][0]}</h3><p class="mt-2 text-sm text-ink-2">{items[2][1]}</p>
    </li>
  </ul>
</section>
