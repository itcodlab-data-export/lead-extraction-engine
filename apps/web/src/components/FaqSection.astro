---
import { FAQ } from "../lib/faq";
---
<section class="bg-surface" aria-labelledby="faq-h">
  <div class="wrap section">
    <p class="eyebrow">Buyer questions</p>
    <h2 id="faq-h" class="mt-3 max-w-3xl">Straight answers, before the call.</h2>
    <div class="mt-12 grid gap-x-12 gap-y-10 md:grid-cols-2">
      {FAQ.map((f) => (
        <article>
          <h3>{f.q}</h3>
          <p class="mt-3 text-ink-2 speakable" style="line-height:1.6">{f.a}</p>
        </article>
      ))}
    </div>
  </div>
</section>
