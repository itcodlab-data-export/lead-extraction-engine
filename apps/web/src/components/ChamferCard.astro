---
/** 2-layer cut-edge glass card: outer drop-shadow wrapper, inner clipped glass. */
interface Props { blur?: boolean; notch?: boolean; surface?: boolean; class?: string }
const { blur = false, notch = false, surface = false, class: cls = "" } = Astro.props;
---
<div class:list={["chamfer-shadow", cls]}>
  <div class:list={["chamfer-glass", { frost: blur, notch, surface }]}>
    <slot />
  </div>
</div>

<style>
  .chamfer-shadow { filter: var(--shadow-card); min-width: 0; }
  .chamfer-glass {
    --cut: 14px;
    position: relative;
    background: var(--glass-bg);
    border: 1px solid var(--border-hairline);
    clip-path: polygon(var(--cut) 0, 100% 0, 100% calc(100% - var(--cut)), calc(100% - var(--cut)) 100%, 0 100%, 0 var(--cut));
    padding: clamp(20px, 3.5vw, 36px);
    height: 100%;
  }
  .chamfer-glass.surface { background: var(--bg-surface); }
  .chamfer-glass.frost { -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); }
  /* The clip removes the border on the cut diagonals; redraw them as hairlines. */
  .chamfer-glass::before, .chamfer-glass::after {
    content: ""; position: absolute; width: var(--cut); height: var(--cut); pointer-events: none;
  }
  .chamfer-glass::before {
    top: -1px; left: -1px;
    background: linear-gradient(135deg, transparent 50%, var(--border-hairline) 50% 70%, transparent 70%);
  }
  .chamfer-glass::after {
    bottom: -1px; right: -1px;
    background: linear-gradient(135deg, transparent 30%, var(--border-hairline) 30% 50%, transparent 50%);
  }
  .chamfer-glass.notch::before {
    background: linear-gradient(135deg, transparent 50%, var(--accent-red) 50% 78%, transparent 78%);
  }
</style>
