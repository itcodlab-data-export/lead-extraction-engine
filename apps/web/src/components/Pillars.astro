---
import { withBase } from "../lib/withBase";
import ChamferCard from "./ChamferCard.astro";
const agency = [
  ["Meta Ads", "Campaign structure, creative testing and budget control on Meta.", "/services/meta-ads-capi/"],
  ["Server-Side CAPI", "Conversion events sent from your server, deduplicated with the pixel.", "/services/meta-ads-capi/"],
  ["Social Media Growth", "Content systems and community management for your social channels.", "/services/social-media-growth/"],
  ["IT & Automation", "Serverless workflows, integrations and AI automation.", "/services/it-automation/"],
];
const products = [
  ["Lead Extraction Engine", "Live", "Collects public intent signals from 14 sources into a sheet you own.", "/products/lead-extraction-engine/"],
  ["Lead Sending Engine", "In development", "Safety-first sending with fixed ceilings and fail-closed controls.", "/products/lead-sending-engine/"],
  ["Early Access / Client Login", "app.itcodlab.com", "Join the list for the client portal and free community tools.", "/early-access/"],
];
---
<section class="wrap section" aria-labelledby="engines-h">
  <p class="eyebrow">Two engines · one foundation</p>
  <h2 id="engines-h" class="mt-3 max-w-3xl">Two Engines Built on One Growth Foundation</h2>

  <div class="mt-14">
    <h3 class="text-2xl">Pillar A — Growth Agency Engine</h3>
    <p class="lede mt-2 max-w-2xl">Meta Ads with server-side CAPI, social media growth and IT automation.</p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {agency.map(([t, d, h]) => (
        <li class="tile"><h4 class="font-display text-lg font-bold">{t}</h4>
          <p class="mt-2 text-sm text-ink-2">{d}</p>
          <a href={withBase(h)} class="mt-4 inline-block text-sm font-semibold text-brand">Learn more →</a></li>
      ))}
    </ul>
  </div>

  <div class="mt-20">
    <h3 class="text-2xl">Pillar B — In-House AI Products</h3>
    <p class="lede mt-2 max-w-2xl">Proprietary tools we build and run ourselves, opening to clients through the portal.</p>
    <ul class="mt-8 grid gap-5 md:grid-cols-3">
      {products.map(([t, tag, d, h], i) => (
        <li>
          <ChamferCard surface notch={i === 0}>
            <span class="badge">{i === 0 && <span class="dot-live" aria-hidden="true" />}{tag}</span>
            <h4 class="mt-4 font-display text-xl font-bold">{t}</h4>
            <p class="mt-2 text-sm text-ink-2">{d}</p>
            <a href={withBase(h)} class="mt-4 inline-block text-sm font-semibold text-brand">Learn more →</a>
          </ChamferCard>
        </li>
      ))}
    </ul>
  </div>
</section>
