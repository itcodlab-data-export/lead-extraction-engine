---
import { withBase } from "../lib/withBase";
---
<section class="wrap pt-16 pb-12 md:pt-24">
  <div class="grid items-end gap-10 md:grid-cols-[1.35fr_1fr] md:gap-16">
    <div>
      <p class="badge mb-6"><span class="dot-live" aria-hidden="true"></span>Agency + in-house AI products</p>
      <h1>Performance marketing, engineered end to end.</h1>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={withBase("/contact/#book")} class="btn-primary">Book Free Audit</a>
        <a href={withBase("/products/")} class="btn-ghost">Explore Products</a>
      </div>
    </div>
    <p class="lede speakable">
      IT Code Lab runs Meta Ads with server-side CAPI, social media growth and IT automation for growing businesses.
      <br class="hidden md:block" />
      We also build two in-house AI products: Lead Extraction Engine and Lead Sending Engine.
    </p>
  </div>
</section>
