---
import { withBase } from "../lib/withBase";
import { NAV, BRAND } from "../lib/site";
---
<header class="sticky top-0 z-50 border-b border-hairline" style="background:var(--glass-bg);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)">
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href={withBase("/")} class="font-display text-lg font-bold" style="letter-spacing:-0.03em">{BRAND}</a>
    <nav aria-label="Primary" class="hidden items-center gap-7 text-sm text-ink-2 md:flex">
      {NAV.map((n) => <a href={withBase(n.href)} class="hover:text-ink">{n.label}</a>)}
    </nav>
    <div class="hidden items-center gap-3 md:flex">
      <a href={withBase("/early-access/")} class="text-sm text-ink-2 hover:text-ink">Client Login</a>
      <a href={withBase("/contact/#book")} class="btn-primary">Book Audit</a>
    </div>
    <details class="relative md:hidden">
      <summary class="btn-ghost cursor-pointer list-none" aria-label="Open menu">Menu</summary>
      <div class="absolute right-0 mt-2 flex w-64 flex-col gap-1 rounded-lg border border-hairline bg-canvas p-3 shadow-lg">
        {NAV.map((n) => <a href={withBase(n.href)} class="rounded px-3 py-3 text-ink">{n.label}</a>)}
        <a href={withBase("/early-access/")} class="rounded px-3 py-3 text-ink">Client Login</a>
        <a href={withBase("/contact/#book")} class="btn-primary mt-1">Book Audit</a>
      </div>
    </details>
  </div>
</header>
