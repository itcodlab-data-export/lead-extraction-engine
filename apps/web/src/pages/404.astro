---
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/withBase";
---
<Base title="Page not found" description="This page does not exist." path="/404/" pageType="WebPage">
  <section class="wrap section">
    <p class="eyebrow">404</p>
    <h1 class="mt-3">Page not found.</h1>
    <p class="lede speakable mt-4">The page you asked for is not here. Try the home page.</p>
    <a href={withBase("/")} class="btn-primary mt-8">Back home</a>
  </section>
</Base>
