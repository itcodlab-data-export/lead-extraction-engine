---
import Base from "../layouts/Base.astro";
import InquiryForm from "../components/InquiryForm.astro";
import { APP_URL } from "../lib/site";
---
<Base title="Early Access & Client Login" path="/early-access/" trail={[{ name: "Early Access", path: "/early-access/" }]}
  description="Join the early-access list for the IT Code Lab client portal, Lead Extraction Engine and Lead Sending Engine.">
  <section class="wrap section">
    <p class="badge"><span class="dot-live" aria-hidden="true"></span>Portal not open yet</p>
    <h1 class="mt-5">Early access &amp; client login.</h1>
    <p class="lede speakable mt-4 max-w-2xl">
      The client portal at {APP_URL.replace("https://", "")} is not open for public sign-up yet. Join the list and we will invite you as seats open.
    </p>
    <div class="mt-12 max-w-xl">
      <InquiryForm source="early-access" selectLabel="I want access to"
        options={["Lead Extraction Engine", "Lead Sending Engine", "Free community tools", "Client portal"]} cta="Join early access" />
    </div>
  </section>
</Base>
