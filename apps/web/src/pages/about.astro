---
import Base from "../layouts/Base.astro";
import { person } from "../lib/schema";
const bio = "Faiz founded IT Code Lab to run performance marketing, social growth and IT automation on systems that can be inspected, and builds the agency's in-house lead extraction and sending products.";
---
<Base title="About" path="/about/" trail={[{ name: "About", path: "/about/" }]} pageType="AboutPage"
  description="About Faiz and IT Code Lab: an agency built on measurable performance marketing and inspectable automation."
  graph={[person("Faiz", "Founder, IT Code Lab", bio, "/about/")]}>
  <section class="wrap section max-w-3xl">
    <p class="eyebrow">About</p>
    <h1 class="mt-3">Built by an operator, not a template.</h1>
    <div class="mt-10 border-l-2 border-hairline pl-6">
      <h2 class="text-2xl">Faiz</h2>
      <p class="font-mono text-xs text-ink-2">Founder, IT Code Lab</p>
      <p class="lede speakable mt-4">{bio}</p>
    </div>
    <div class="prose-lab mt-12">
      <h2>How we work</h2>
      <ul>
        <li><strong>Measure first.</strong> Server-side tracking before scaling spend.</li>
        <li><strong>Automate what repeats.</strong> Small serverless workers beat manual busywork.</li>
        <li><strong>Own your data.</strong> Outputs land in workspaces you control.</li>
        <li><strong>Say what is real.</strong> We publish capabilities, not invented results.</li>
      </ul>
    </div>
  </section>
</Base>
